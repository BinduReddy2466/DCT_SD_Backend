@model FetchHistoryResultsViewModel
@{
    var result = Model.Result;
    var emptyMessage = Model.HasAppliedFilters ? "No records found." : "No fetch history found.";
}

<div class="table-responsive table-frame">
    @* align-top (not align-middle): Fetch Summary can be several lines tall (its embedded line
       breaks are preserved below), which previously made every other cell in that same row -
       including the View button - vertically centered against that extra height, so the button's
       position visibly shifted row to row depending on how long that row's summary was. Top-
       aligning keeps every cell starting at the same edge regardless of row height - a no-op for
       any row where every cell is already single-line (the common case), since there's no extra
       height to center against there anyway. *@
    <table class="table table-hover align-top">
        <thead>
            <tr>
                <th>Fetch Date and Time</th>
                <th>Fetch Completion Date and Time</th>
                <th>Fetch Run Time</th>
                <th>Fetch Progress</th>
                <th>Fetch Status</th>
                <th>Executed By</th>
                <th>Fetch Summary</th>
                <th>Source Path</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (result.Items.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">@emptyMessage</td></tr>
            }
            else
            {
                @foreach (var item in result.Items)
                {
                    var fetchPct = item.TotalCount.HasValue && item.TotalCount.Value > 0
                        ? Math.Min(100, (int)Math.Round(item.ProcessedCount * 100.0 / item.TotalCount.Value))
                        : (item.Status != "Ongoing" ? 100 : 0);
                    var fetchComplete = item.Status != "Ongoing";
                    <tr>
                        <td class="font-monospace small">@item.StartedAt.ToLocalDisplay().ToString("MM/dd/yyyy h:mm tt")</td>
                        <td class="font-monospace small">@(item.CompletedAt.ToLocalDisplay()?.ToString("MM/dd/yyyy h:mm tt") ?? "—")</td>
                        <td>@(item.RunTime ?? "—")</td>
                        <td>
                            <div class="fetch-progress">
                                <div class="fetch-progress-track">
                                    <div class="fetch-progress-fill @(fetchComplete ? "is-complete" : "")" style="width: @(fetchPct)%;"></div>
                                </div>
                                <span class="fetch-progress-count">@item.ProcessedCount/@(item.TotalCount?.ToString() ?? "—")</span>
                            </div>
                        </td>
                        <td><status-badge status="@(item.Status == "Ongoing" ? "Ongoing Fetching" : item.Status)"></status-badge></td>
                        <td><span class="chip-mono">@item.ExecutedBy</span></td>
                        @* white-space: pre-line preserves the message's own line breaks (e.g. the
                           "Successfully Extracted / Failed / Moved to Empty Entry Folders / Total
                           Folders Processed" breakdown) while still wrapping long lines normally.
                           overflow-wrap/max-width keep this column from stretching the whole table
                           wider than its container when a line has no natural break point to wrap
                           at (e.g. one long unbroken run of characters) - content still wraps and
                           stays fully visible, just within a bounded column width instead of
                           forcing the table to overflow. *@
                        <td class="small" style="white-space: pre-line; overflow-wrap: break-word; max-width: 280px;">@(string.IsNullOrWhiteSpace(item.FailureReason) ? "—" : item.FailureReason)</td>
                        <td class="font-monospace small" style="overflow-wrap: break-word; max-width: 240px;">@item.SourcePath</td>
                        <td style="white-space: nowrap;">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-modal-url="@Url.Action("FetchRunDetails", new { id = item.Id })">View</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (result.TotalCount > 0)
{
    @await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = result.PageNumber, PageSize = result.PageSize, TotalCount = result.TotalCount, TotalPages = result.TotalPages, ActionName = "FetchHistoryResults" })
}
