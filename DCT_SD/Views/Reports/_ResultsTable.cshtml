@model DCT_SD.Models.Dtos.Reports.ReportPreviewDto

<div class="table-responsive table-frame">
    <table class="table table-hover align-middle mb-0">
        @if (Model.Headers.Count > 0)
        {
            <thead>
                <tr>
                    @foreach (var header in Model.Headers)
                    {
                        <th>@header</th>
                    }
                </tr>
            </thead>
        }
        <tbody>
            @if (Model.Rows.Count == 0 && Model.Headers.Count == 0)
            {
                // No Report Type selected yet (the initial page load, or a direct/stale request
                // with no reportType) - there's nothing to search yet, so showing "No records
                // found." here would wrongly imply a search already ran and matched nothing.
            }
            else if (Model.Rows.Count == 0)
            {
                <tr><td colspan="@Math.Max(Model.Headers.Count, 1)" class="text-center text-muted py-4">No records found.</td></tr>
            }
            else
            {
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @for (var i = 0; i < row.Count; i++)
                        {
                            var cell = row[i];
                            var display = string.IsNullOrWhiteSpace(cell) ? "—" : cell;
                            var header = i < Model.Headers.Count ? Model.Headers[i] : null;
                            if (header == "Remarks")
                            {
                                // Only the Root Source Path Update History report has a "Remarks"
                                // column ("Remarks" never appears as a header for any other report
                                // type) - matches the same truncate-with-tooltip treatment already
                                // used for this exact column on the real Root Source Path Update
                                // History page (_RootHistoryResults.cshtml), so long remarks aren't
                                // shown broken across multiple lines here either.
                                <td><div class="text-truncate" style="max-width: 320px;" title="@cell">@display</div></td>
                            }
                            else if (header is "Entry Number" or "Entry No.")
                            {
                                // "Entry Number" (Manual Validation) / "Entry No." (Migration
                                // Monitoring) can be a comma-separated EntryNumberRange with
                                // hundreds of entries (see ManualValidationService.cs) - same
                                // truncate-with-tooltip treatment as Remarks above, so a single
                                // long value can't blow a row out to fill the page here either,
                                // matching the real Manual Validation/Migrations list pages
                                // (_Results.cshtml, via Helpers.TextTruncate).
                                <td><div class="text-truncate" style="max-width: 260px;" title="@cell">@display</div></td>
                            }
                            else
                            {
                                @* white-space: pre-line matches the Fetch History page's own Fetch
                                   Summary column (_FetchHistoryResults.cshtml) - preserves that
                                   field's embedded line breaks. A no-op for every other column/
                                   report type, since none of them contain embedded line breaks. *@
                                <td style="white-space: pre-line;">@display</td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.Rows.Count > 0)
{
    @await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, ActionName = "Results" })
}
