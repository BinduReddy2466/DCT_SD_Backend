@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var backgroundUrl = ViewData["LoginBackgroundUrl"] as string;
    var backgroundStyle = string.IsNullOrEmpty(backgroundUrl)
        ? "background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-3) 100%);"
        : $"background: url('{backgroundUrl}') center / cover no-repeat;";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; @backgroundStyle">
    <form asp-controller="Account" asp-action="Login" method="post" class="login-card">
        <h2 class="font-display fw-bold mb-3">Welcome back</h2>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label field-label"></label>
            <input asp-for="Username" class="form-control" placeholder="you@example.com" autofocus />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label field-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Enter Password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <input type="hidden" asp-for="ReturnUrl" />

        <button type="submit" class="btn btn-navy w-100 mt-2">Sign In</button>
    </form>
</div>
