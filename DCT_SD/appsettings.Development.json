  "RemoteFolderBrowser": {
    // Local-development-only override of the base appsettings.json value (which stays empty/
    // whatever VM-QA actually needs). ASP.NET Core layers this file over appsettings.json
    // automatically whenever ASPNETCORE_ENVIRONMENT=Development, so this never affects the VM/
    // QA/Production config. Browse runs entirely server-side (Directory.GetDirectories against
    // the server's own filesystem, never anything on the client's machine) - "/" offers this
    // whole dev server's filesystem in the picker, so no specific folder needs configuring here.
    "NetworkRoots": [
      "/"
    ]
  }
