@using System.Text.Json
@using DCT_SD.Models.Dtos.Settings
@model SessionSettingsDto
@{
    var branding = (BrandingDto)ViewData["Branding"]!;
    var emailTemplates = (IReadOnlyList<EmailTemplateDto>)ViewData["EmailTemplates"]!;
    var emailTemplatesJson = JsonSerializer.Serialize(emailTemplates, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var standardMinutes = new[] { "5", "10", "15", "20", "30", "60" };
    var isCustomTimeout = !standardMinutes.Contains(Model.TimeoutMinutes.ToString());
}

<div class="card p-0" style="overflow: hidden;">
    <ul class="nav nav-tabs px-3 pt-2" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-branding" type="button">Branding</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-email" type="button">Email Templates</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-session" type="button">Session</button>
        </li>
    </ul>

    <div class="tab-content p-4">
        <!-- Branding -->
        <div class="tab-pane fade show active" id="tab-branding">
            <h6 class="font-display fw-semibold mb-2">Login Background Image</h6>
            <p class="text-muted small mb-3">Uploaded image is used as the full-screen background on the Sign In page.</p>

            <div id="brandingPreview" class="border rounded d-flex align-items-center justify-content-center text-muted small"
                 style="width: 400px; height: 280px; background-size: cover; background-position: center; @(branding.ImageUrl != null ? $"background-image:url('{branding.ImageUrl}');" : "")">
                @if (branding.ImageUrl == null)
                {
                    <span>No image uploaded</span>
                }
            </div>

            <div class="d-flex gap-2 mt-3">
                <label class="btn btn-outline-secondary mb-0">
                    Upload Image
                    <input type="file" id="brandingFileInput" accept="image/*" class="d-none" />
                </label>
                <button type="button" id="brandingRemoveBtn" class="btn btn-outline-danger" style="display:@(branding.ImageUrl == null ? "none" : "inline-block")">Remove Image</button>
            </div>
            <form id="brandingUploadForm" style="display:none">@Html.AntiForgeryToken()</form>
        </div>

        <!-- Email Templates -->
        <div class="tab-pane fade" id="tab-email">
            <div class="d-flex flex-wrap gap-2 mb-3" id="emailTemplateTabs">
                @for (var i = 0; i < emailTemplates.Count; i++)
                {
                    <button type="button" class="btn btn-sm @(i == 0 ? "btn-navy" : "btn-outline-secondary")" data-email-template-key="@emailTemplates[i].Key">@emailTemplates[i].Label</button>
                }
            </div>

            <form id="emailTemplateForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label field-label" for="emailTplRecipients">Recipient(s)</label>
                    <input type="text" class="form-control mt-1" id="emailTplRecipients" name="Recipients" />
                </div>
                <div class="mb-3">
                    <label class="form-label field-label" for="emailTplSubject">Subject</label>
                    <input type="text" class="form-control mt-1" id="emailTplSubject" name="Subject" />
                </div>
                <div class="mb-3">
                    <label class="form-label field-label" for="emailTplBody">Email Body</label>
                    <textarea class="form-control mt-1" id="emailTplBody" name="Body" rows="8"></textarea>
                    <p class="text-muted small mt-1 mb-0">
                        Placeholders: {{FirstName}} {{LastName}} {{Email}} {{TemporaryPassword}} {{ResetPasswordLink}} {{ChangePasswordLink}} {{CurrentDate}}
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="emailTplSaveBtn" class="btn btn-navy">Save</button>
                    <button type="button" id="emailTplPreviewBtn" class="btn btn-outline-secondary">Preview</button>
                    <button type="button" id="emailTplRestoreBtn" class="btn btn-outline-secondary">Restore Default</button>
                </div>
            </form>
        </div>

        <!-- Session -->
        <div class="tab-pane fade" id="tab-session">
            <h6 class="font-display fw-semibold mb-3">Session Settings</h6>
            <div class="mb-3" style="max-width: 420px;">
                <label class="form-label field-label" for="sessionTimeoutSelect">Inactivity Timeout</label>
                <select class="form-select mt-1" id="sessionTimeoutSelect">
                    @foreach (var minutes in standardMinutes)
                    {
                        <option value="@minutes" selected="@(!isCustomTimeout && Model.TimeoutMinutes.ToString() == minutes)">@minutes minutes</option>
                    }
                    <option value="custom" selected="@isCustomTimeout">Custom…</option>
                </select>
            </div>
            <div class="mb-3" style="max-width: 420px; @(isCustomTimeout ? "" : "display:none;")" id="sessionCustomMinutesWrap">
                <label class="form-label field-label" for="sessionCustomMinutes">Custom Timeout (minutes)</label>
                <input type="text" class="form-control mt-1" id="sessionCustomMinutes" placeholder="e.g. 45" value="@(isCustomTimeout ? Model.TimeoutMinutes.ToString() : "")" />
            </div>
            <div class="mb-3">
                <label class="form-label field-label">Timeout Action</label>
                <div class="mt-2 d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sessionTimeoutAction" id="sessionActionLock" value="Lock" checked="@(Model.Action == "Lock")" />
                        <label class="form-check-label" for="sessionActionLock">Lock Screen</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sessionTimeoutAction" id="sessionActionLogout" value="Logout" checked="@(Model.Action == "Logout")" />
                        <label class="form-check-label" for="sessionActionLogout">Logout User</label>
                    </div>
                </div>
            </div>

            <form method="post" action="@Url.Action("UpdateSession")" id="sessionSettingsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TimeoutMinutes" id="sessionTimeoutMinutesHidden" />
                <input type="hidden" name="Action" id="sessionActionHidden" />
                <button type="submit" class="btn btn-navy">Save Session Settings</button>
            </form>
        </div>
    </div>
</div>

<!-- Email preview modal -->
<div class="modal fade" id="emailPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-display">Email Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted mb-2">To: <span class="fw-medium" id="emailPreviewTo"></span></div>
                <div class="small text-muted mb-3">Subject: <span class="fw-medium" id="emailPreviewSubject"></span></div>
                <div class="border rounded p-3 small" style="white-space: pre-wrap;" id="emailPreviewBody"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="emailTemplatesData" type="application/json">@Html.Raw(emailTemplatesJson)</script>
    <script src="~/js/settings.js"></script>
}
