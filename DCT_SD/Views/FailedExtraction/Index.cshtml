@model DCT_SD.Models.ViewModels.FailedExtractionResultsViewModel
@using DCT_SD.Models.Dtos.RdConfig
@{
    var q = Context.Request.Query;
    var registryOffices = (IReadOnlyList<RegistryOfficeDto>)ViewData["RegistryOffices"]!;
}

<div class="card p-4 mb-4">
    <form data-list-page-form="failed-extraction-results" action="@Url.Action("Results")" method="get" class="filter-grid" id="failedExtractionFilterForm">
        <div>
            <label class="form-label field-label" for="DateFrom">Extraction Date From</label>
            <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@q["DateFrom"]" />
        </div>
        <div>
            <label class="form-label field-label" for="DateTo">Extraction Date To</label>
            <input type="date" class="form-control" id="DateTo" name="DateTo" value="@q["DateTo"]" />
        </div>
        <div>
            <label class="form-label field-label" for="Rd">RD</label>
            <input type="text" class="form-control" id="Rd" name="Rd" value="@q["Rd"]" list="rdOptionsList" placeholder="Select" autocomplete="off" />
            <datalist id="rdOptionsList">
                @foreach (var o in registryOffices)
                {
                    <option value="@o.Name"></option>
                }
            </datalist>
        </div>
        <div>
            <label class="form-label field-label" for="FolderName">Entry Folder Name</label>
            <input type="text" class="form-control" id="FolderName" name="FolderName" value="@q["FolderName"]" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-navy flex-fill">Search</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" data-list-page-clear>Clear</button>
        </div>
    </form>
</div>

<div class="card p-0">
    <div class="p-4 border-bottom">
        <h2 class="font-display fs-5 fw-semibold mb-0">Failed Extraction</h2>
        <p class="text-muted small mb-0 mt-1">Entry Folders where OCR extraction failed at the system level.</p>
    </div>

    <div id="failed-extraction-results" class="p-0">
        @await Html.PartialAsync("_Results", Model)
    </div>
</div>
