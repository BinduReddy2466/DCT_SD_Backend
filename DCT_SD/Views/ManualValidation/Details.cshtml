@using System.Text.Json
@using DCT_SD.Helpers
@using DCT_SD.Models.ViewModels
@model DCT_SD.Models.Dtos.ManualValidation.ManualValidationDetailDto
@{
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var documentsJson = JsonSerializer.Serialize(Model.Documents, jsonOptions);
    var registryOfficesJson = JsonSerializer.Serialize((IReadOnlyList<DCT_SD.Models.Dtos.RdConfig.RegistryOfficeDto>)ViewData["RegistryOffices"]!, jsonOptions);
    var documentTypesJson = JsonSerializer.Serialize((IReadOnlyList<DCT_SD.Models.Dtos.ManualValidation.DocumentTypeDto>)ViewData["DocumentTypes"]!, jsonOptions);
    var missing = new HashSet<string>(Model.MissingFields);
    var remarksVm = new RemarksHistoryViewModel { RecordId = Model.Id, Remarks = (DCT_SD.Models.PagedResult<DCT_SD.Models.Dtos.ManualValidation.ManualValidationRemarkDto>)ViewData["Remarks"]! };

    string MissingClass(string key) => missing.Contains(key) ? "missing-field" : "";
}

<div class="mb-3 d-flex align-items-center justify-content-between">
    <a href="@Url.Action("Index")" class="d-inline-flex align-items-center gap-2 text-decoration-none">&lsaquo; Back to Manual Validation</a>
    <status-badge status="@StatusDisplay.ManualValidationStatusToDisplay(Model.Status)"></status-badge>
</div>

<form id="mvDetailsForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="mvRecordId" value="@Model.Id" />
    <!-- Zero or more pending Others -> Document Type corrections (JSON array of {index, code,
         name}), per the acceptance criteria: only ever sent to the server as part of this same
         Save submit - never on selection change. -->
    <input type="hidden" id="mvDocumentChangesJson" name="DocumentChangesJson" value="" />

    <div class="card p-4 mb-4">
        <h6 class="text-muted text-uppercase small fw-semibold mb-3">General Information</h6>
        <div class="row g-3">
            <div class="col-12 col-md-4 mb-3 @MissingClass("rdCode")">
                <label class="field-label" for="mvRdCode">RD Code</label>
                <input type="text" class="form-control mt-1" id="mvRdCode" name="RdCode" value="@Model.RdCode" />
            </div>
            <div class="col-12 col-md-4 mb-3 @MissingClass("rdName")">
                <label class="field-label" for="mvRdName">RD Name</label>
                <input type="text" class="form-control mt-1 bg-body-secondary" id="mvRdName" readonly value="@Model.RdName" />
            </div>
            <div class="col-12 col-md-4 mb-3 @MissingClass("entry")">
                <label class="field-label" for="mvEntry">Entry Number</label>
                <input type="text" class="form-control mt-1" id="mvEntry" name="EntryNumbersCsv" value="@Model.EntryNumbersCsv" />
            </div>
        </div>
    </div>

    <div class="card p-4 mb-4">
        <h6 class="text-muted text-uppercase small fw-semibold mb-3">Title Record(s)</h6>
        <div class="table-responsive table-frame">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">#</th>
                        <th style="min-width: 150px;">Title Number</th>
                        <th style="min-width: 110px;">Title Type</th>
                        <th style="min-width: 150px;">Plan Number</th>
                        <th style="min-width: 110px;">Block Number</th>
                        <th style="min-width: 100px;">Lot Number</th>
                        <th style="min-width: 150px;">Title Sequence</th>
                        <th style="min-width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- The current data model returns exactly one Title Record per Manual
                         Validation request (Title/TitleType/Plan/Block/Lot/TitleSequence are
                         singular columns, not a collection) - this table renders that one record
                         as a row; it is not a user-editable list, so there is no Add Title
                         Record affordance. -->
                    <tr>
                        <td class="small text-muted">1</td>
                        <td class="mb-3 @MissingClass("title")">
                            <input type="text" class="form-control form-control-sm" id="mvTitle" name="Title" value="@Model.Title" aria-label="Title Number" />
                        </td>
                        <td class="mb-3 @MissingClass("titleType")">
                            <select class="form-select form-select-sm" id="mvTitleType" name="TitleType" aria-label="Title Type">
                                <option value="">Select</option>
                                <option value="TCT" selected="@(Model.TitleType == "TCT")">TCT</option>
                                <option value="OCT" selected="@(Model.TitleType == "OCT")">OCT</option>
                            </select>
                        </td>
                        <td class="mb-3 @MissingClass("plan")">
                            <input type="text" class="form-control form-control-sm" id="mvPlan" name="Plan" placeholder="Required" value="@Model.Plan" aria-label="Plan Number" />
                        </td>
                        <td class="mb-3 @MissingClass("block")">
                            <input type="text" class="form-control form-control-sm" id="mvBlock" name="Block" placeholder="Required" value="@Model.Block" aria-label="Block Number" />
                        </td>
                        <td class="mb-3 @MissingClass("lot")">
                            <input type="text" class="form-control form-control-sm" id="mvLot" name="Lot" placeholder="Required" value="@Model.Lot" aria-label="Lot Number" />
                        </td>
                        <td class="mb-3 @MissingClass("titleSequence")">
                            <input type="text" class="form-control form-control-sm bg-body-secondary font-monospace" id="mvTitleSeq" name="TitleSequence" readonly
                                   placeholder="@(string.IsNullOrWhiteSpace(Model.TitleSequence) ? "Not yet retrieved" : "")" value="@Model.TitleSequence" aria-label="Title Sequence" />
                        </td>
                        <td>
                            <button type="button" id="mvRetrieveTitleSeqBtn" class="btn btn-outline-secondary btn-sm w-100">Retrieve Title Sequence</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0">Fields outlined in gold were flagged missing during OCR extraction.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-7">
            <div class="card p-4 d-flex flex-column h-100" id="mvViewer" data-doc-viewer>
                <h6 class="text-muted text-uppercase small fw-semibold mb-3">Image Viewer</h6>
                @if (Model.Documents.Count == 0)
                {
                    <div class="flex-1 d-flex align-items-center justify-content-center text-muted py-5">No Supporting Documents Found</div>
                }
                else
                {
                    <div class="mb-3 d-flex align-items-center gap-2">
                        <span class="field-label mb-0">Document Type</span>
                        <span class="small fw-medium" id="mvDocTypeText"></span>
                        <select class="form-select form-select-sm d-none" style="max-width: 320px;" id="mvDocTypeSelect">
                            <option value="">Select</option>
                        </select>
                    </div>

                    <div class="mb-3 d-flex flex-wrap align-items-center justify-content-center gap-2">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="zoomIn">+</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="zoomOut">&minus;</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="actualSize">100%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="rotateLeft">&#8634;</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="rotateRight">&#8635;</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="togglePan">&#10021;</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="reset">Reset</button>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="prev">&lsaquo; Prev</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-viewer-action="next">Next &rsaquo;</button>
                        </div>
                    </div>

                    <div class="doc-viewer-frame flex-fill d-flex align-items-center justify-content-center" data-viewer-frame style="min-height: 440px; overflow: hidden;">
                        <img data-viewer-image draggable="false" style="max-width: 100%; max-height: 100%;" />
                    </div>

                    <div class="mt-3 text-center">
                        <div class="small text-muted" data-viewer-header-right></div>
                        <div class="small text-muted font-monospace text-break mt-1" data-viewer-filename></div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card p-4 h-100">
                <h6 class="text-muted text-uppercase small fw-semibold mb-3">Supporting Documents</h6>
                @if (Model.Documents.Count == 0)
                {
                    <div class="text-center text-muted py-4">No documents found.</div>
                }
                else
                {
                    <div class="table-responsive table-frame flex-fill" style="overflow-y: auto; min-height: 0;">
                        <table class="table table-hover align-middle mb-0" style="table-layout: fixed;">
                            <thead>
                                <tr>
                                    <th style="width: 2.25rem;">#</th>
                                    <th>Image File Name</th>
                                    <th>Document Name</th>
                                </tr>
                            </thead>
                            <tbody id="mvDocumentList">
                                @for (var i = 0; i < Model.Documents.Count; i++)
                                {
                                    var doc = Model.Documents[i];
                                    <tr role="button" data-doc-index="@i" class="@(i == 0 ? "table-active" : "")" style="cursor: pointer;">
                                        <td class="small text-muted">@(i + 1)</td>
                                        <td class="small font-monospace text-break">@doc.RenamedFileName</td>
                                        <td class="small fw-medium text-break">@doc.DocumentName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card p-4 mt-4">
        <h6 class="text-muted text-uppercase small fw-semibold mb-3">Remarks History</h6>
        <div id="mvRemarksHistory">
            @await Html.PartialAsync("_RemarksHistoryTable", remarksVm)
        </div>
    </div>
</form>

<div class="mt-3 d-flex justify-content-end gap-2">
    <button type="button" id="mvCloseBtn" class="btn btn-outline-secondary px-4">Close</button>
    <button type="button" id="mvSaveBtn" class="btn btn-outline-secondary px-4">Save</button>
    <button type="button" id="mvMigrateBtn" class="btn btn-gold px-4">Migrate</button>
</div>

<div class="modal fade" id="mvCloseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-display">Close with remarks</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea class="form-control" id="mvCloseRemarksText" rows="3" placeholder="e.g. Awaiting confirmation of Plan/Block/Lot from field office"></textarea>
                <p class="text-danger small mt-1 d-none" id="mvCloseRemarksError">Remarks is required.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-navy" id="mvCloseConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mvUnsavedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-display">You have unsaved changes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Do you want to save your changes before closing?</p>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-navy" id="mvSaveAndCloseBtn">Save and Close</button>
                    <button type="button" class="btn btn-outline-secondary" id="mvDiscardAndCloseBtn">Close Without Saving</button>
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="mvDocumentsData" type="application/json">@Html.Raw(documentsJson)</script>
    <script id="mvRegistryOfficesData" type="application/json">@Html.Raw(registryOfficesJson)</script>
    <script id="mvDocumentTypesData" type="application/json">@Html.Raw(documentTypesJson)</script>
    <script src="~/js/placeholder-image.js" asp-append-version="true"></script>
    <script src="~/js/doc-viewer.js" asp-append-version="true"></script>
    <script src="~/js/manual-validation-details.js" asp-append-version="true"></script>
}
