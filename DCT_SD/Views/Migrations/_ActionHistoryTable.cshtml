@using DCT_SD.Helpers
@model IReadOnlyList<DCT_SD.Models.Dtos.Migrations.MigrationActionHistoryDto>
@if (Model.Count == 0)
{
    <div class="flex-fill d-flex align-items-center justify-content-center text-muted">No Action History Found</div>
}
else
{
    <div class="table-responsive table-frame flex-fill" style="min-height: 0; min-width: 0; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Activity</th>
                    <th>Status</th>
                    <th>Performed By</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    var historyIsSystemMigration = h.MigrationType == "SystemMigration";
                    var historyStatusDisplay = historyIsSystemMigration
                        ? StatusDisplay.MigrationProcessingStatusToDisplay(h.Status)
                        : StatusDisplay.MigrationStatusToDisplay(h.Status);
                    <tr>
                        <td>@h.ActionDate.ToLocalDisplay().ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@h.Activity</td>
                        <td>@(string.IsNullOrEmpty(historyStatusDisplay) ? "—" : historyStatusDisplay)</td>
                        <td>@(h.PerformedBy ?? "—")</td>
                        <td class="cell-wrap">@(h.Remarks ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
