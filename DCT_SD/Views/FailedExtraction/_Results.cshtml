@model DCT_SD.Models.ViewModels.FailedExtractionResultsViewModel
@{
    var items = Model.Result.Items;
    var emptyMessage = Model.HasAnyRecords ? "No records found." : "No failed extraction records found.";
}

<div class="table-responsive table-frame">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Extraction Date and Time</th>
                <th>RD</th>
                <th>Entry Folder Name</th>
                <th>Folder Path</th>
                <th>Failure Reason</th>
            </tr>
        </thead>
        <tbody>
            @if (items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">@emptyMessage</td></tr>
            }
            else
            {
                @foreach (var item in items)
                {
                    <tr>
                        <td class="font-monospace small">@item.ExtractionDateTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@(item.RdName ?? "—")</td>
                        <td>@item.FolderName</td>
                        <td class="font-monospace small">@item.FolderPath</td>
                        <td>@(string.IsNullOrWhiteSpace(item.FailureReason) ? "—" : item.FailureReason)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (items.Count > 0)
{
    @await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = Model.Result.PageNumber, PageSize = Model.Result.PageSize, TotalCount = Model.Result.TotalCount, TotalPages = Model.Result.TotalPages, ActionName = "Results" })
}
