@using DCT_SD.Helpers
@using DCT_SD.Models.Dtos.RdConfig
@using DCT_SD.Models.Enums
@model DCT_SD.Models.PagedResult<DCT_SD.Models.Dtos.Migrations.MigrationListItemDto>
@{
    var q = Context.Request.Query;
    var registryOffices = (IReadOnlyList<RegistryOfficeDto>)ViewData["RegistryOffices"]!;
}

<div class="card p-4 mb-4">
    <form data-list-page-form="migrations-results" data-list-page-page-url="@Url.Action("Index")"
          data-list-page-required="EntryNumbersCsv" data-list-page-required-message="Entry Number is required."
          action="@Url.Action("Results")" method="get" class="filter-grid">
        <div>
            <label class="form-label field-label" for="RdCode">Registry of Deeds</label>
            <select class="form-select" id="RdCode" name="RdCode">
                <option value="">Select</option>
                @foreach (var o in registryOffices)
                {
                    <option value="@o.Code" selected="@(q["RdCode"] == o.Code)">@o.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label field-label" for="RequestNumber">Request ID</label>
            <input type="text" class="form-control" id="RequestNumber" name="RequestNumber" value="@q["RequestNumber"]" />
        </div>
        <div>
            <label class="form-label field-label" for="EntryNumbersCsv">Entry Number</label>
            <input type="text" class="form-control" id="EntryNumbersCsv" name="EntryNumbersCsv" value="@q["EntryNumbersCsv"]" />
        </div>
        <div>
            <label class="form-label field-label" for="Title">Title Number</label>
            <input type="text" class="form-control" id="Title" name="Title" value="@q["Title"]" />
        </div>
        <div>
            <label class="form-label field-label" for="MigrationStatus">Migration Status</label>
            <select class="form-select" id="MigrationStatus" name="MigrationStatus">
                <option value="">Select</option>
                @{
                    // The 5 consolidated values MigrationService.ConsolidatedMigrationStatus can
                    // ever return - not the raw MigrationStatus enum, which no longer matches what
                    // the list/details page actually display.
                    var consolidatedStatuses = new[] { "Ready for Migration", "N/A", "Migrated", "Failed Migration", "Migrating" };
                }
                @foreach (var status in consolidatedStatuses)
                {
                    <option value="@status" selected="@(q["MigrationStatus"] == status)">@status</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label field-label" for="DateFrom">Migration Date From</label>
            <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@q["DateFrom"]" />
        </div>
        <div>
            <label class="form-label field-label" for="DateTo">Migration Date To</label>
            <input type="date" class="form-control" id="DateTo" name="DateTo" value="@q["DateTo"]" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-navy flex-fill">Search</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" data-list-page-clear>Clear</button>
        </div>
    </form>
</div>

<div class="card p-4">
    <div id="migrations-results">
        @await Html.PartialAsync("_Results", Model)
    </div>
</div>

<!-- Antiforgery token for the list page's own AJAX Reprocess call (migration-monitoring.js) -
     kept outside #migrations-results so it survives list-page.js's AJAX swap of that container. -->
<form id="migrationListAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="migrationListReprocessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-display">Reprocess Migration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Are you sure you want to reprocess the failed migration for this Entry Record? This action will retry the failed migration.</p>
                <textarea class="form-control" id="migrationListReprocessRemarksText" rows="3" placeholder="Remarks"></textarea>
                <p class="text-danger small mt-1 d-none" id="migrationListReprocessRemarksError">Remarks is required.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-navy" id="migrationListReprocessConfirmBtn" disabled>Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/migration-monitoring.js"></script>
}
