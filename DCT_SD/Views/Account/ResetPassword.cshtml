@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    var tokenInvalid = ViewData["TokenInvalid"] is true;
    var tokenExpired = ViewData["TokenExpired"] is true;
}

<div class="login-shell">
    <div class="login-theme-toggle form-check form-switch mb-0" title="Switch between Light and Dark theme">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
        <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" style="cursor: pointer;" aria-label="Toggle Dark theme">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" /></svg>
    </div>
    <div class="login-hero">
        <div class="login-hero-photo" style="background-image: url('@Url.Content("~/images/login-hero.png")');"></div>
        <div class="login-hero-scrim"></div>
        <div class="login-hero-brand">
            <div class="login-hero-brand-mark">DCT</div>
            <div>
                <div class="login-hero-brand-title">DCT &ndash; SD</div>
                <div class="login-hero-brand-subtitle">Supporting Documents</div>
            </div>
        </div>
        <div class="login-hero-footer">Authorized personnel only &middot; Activity is logged and monitored</div>
    </div>

    <div class="login-form-panel">
        @if (tokenExpired)
        {
            <div class="login-form-card">
                <div class="login-form-eyebrow">Reset Password</div>
                <h2 class="font-display fw-bold login-form-title">Link expired</h2>
                <p class="login-form-subtitle">This password reset link has expired. Please request a new one.</p>
                <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-navy w-100 mt-2">Request a New Link</a>
                <p class="login-form-footnote">
                    <a asp-controller="Account" asp-action="Login" class="login-forgot-link">Back to Sign In</a>
                </p>
            </div>
        }
        else if (tokenInvalid)
        {
            <div class="login-form-card">
                <div class="login-form-eyebrow">Reset Password</div>
                <h2 class="font-display fw-bold login-form-title">Link invalid</h2>
                <p class="login-form-subtitle">This reset-password link is not valid. Please request a new one or contact your Administrator.</p>
                <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-navy w-100 mt-2">Request a New Link</a>
                <p class="login-form-footnote">
                    <a asp-controller="Account" asp-action="Login" class="login-forgot-link">Back to Sign In</a>
                </p>
            </div>
        }
        else
        {
            <form asp-controller="Account" asp-action="ResetPassword" method="post" class="login-form-card">
                <div class="login-form-eyebrow">Reset Password</div>
                <h2 class="font-display fw-bold login-form-title">Set a new password</h2>
                <p class="login-form-subtitle">Choose a new password to finish securing your account</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert" style="white-space: pre-line;"></div>

                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label field-label"></label>
                    <div class="input-icon-group">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7l8 6 8-6" />
                        </svg>
                        <input asp-for="Email" class="form-control" readonly tabindex="-1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label field-label"></label>
                    <div class="input-icon-group">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="5" y="10.5" width="14" height="9" rx="2" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
                        </svg>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" autocomplete="new-password" autofocus id="resetNewPasswordInput" />
                        <button type="button" class="password-toggle" id="resetNewPasswordToggle" aria-label="Show password" aria-pressed="false">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" />
                                <circle cx="12" cy="12" r="2.75" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small" style="white-space: pre-line;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label field-label"></label>
                    <div class="input-icon-group">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="5" y="10.5" width="14" height="9" rx="2" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
                        </svg>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" autocomplete="new-password" id="resetConfirmPasswordInput" />
                        <button type="button" class="password-toggle" id="resetConfirmPasswordToggle" aria-label="Show password" aria-pressed="false">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" />
                                <circle cx="12" cy="12" r="2.75" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-navy w-100 mt-2">Reset Password</button>

                <p class="login-form-footnote">Having trouble? Contact your system administrator.</p>
            </form>
        }
    </div>
</div>

@if (!tokenInvalid && !tokenExpired)
{
    <script>
        (function () {
            function wireToggle(toggleId, inputId) {
                var toggle = document.getElementById(toggleId);
                var input = document.getElementById(inputId);
                if (!toggle || !input) return;
                toggle.addEventListener('click', function () {
                    var isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', String(isPassword));
                    toggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                    toggle.classList.toggle('is-visible', isPassword);
                });
            }
            wireToggle('resetNewPasswordToggle', 'resetNewPasswordInput');
            wireToggle('resetConfirmPasswordToggle', 'resetConfirmPasswordInput');
        })();
    </script>
}
