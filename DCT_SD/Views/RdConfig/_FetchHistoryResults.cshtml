@model DCT_SD.Models.PagedResult<DCT_SD.Models.Dtos.RdConfig.FetchRunItemDto>

<div class="table-responsive table-frame">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Fetch Date and Time</th>
                <th>Fetch Completion Date and Time</th>
                <th>Fetch Run Time</th>
                <th>Fetch Progress</th>
                <th>Fetch Status</th>
                <th>Executed By</th>
                <th>Failure Reason</th>
                <th>Source Path</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No fetch history found.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="font-monospace small">@item.StartedAt.ToIst().ToString("MM/dd/yyyy h:mm tt")</td>
                        <td class="font-monospace small">@(item.CompletedAt.ToIst()?.ToString("MM/dd/yyyy h:mm tt") ?? "—")</td>
                        <td>@(item.RunTime ?? "—")</td>
                        <td>@item.ProcessedCount/@(item.TotalCount?.ToString() ?? "—")</td>
                        <td><status-badge status="@(item.Status == "Ongoing" ? "Ongoing Fetching" : item.Status)"></status-badge></td>
                        <td><span class="chip-mono">@item.ExecutedBy</span></td>
                        <td class="small">@(string.IsNullOrWhiteSpace(item.FailureReason) ? "—" : item.FailureReason)</td>
                        <td class="font-monospace small">@item.SourcePath</td>
                        <td>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-modal-url="@Url.Action("FetchRunDetails", new { id = item.Id })">View</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalCount > 0)
{
    @await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, ActionName = "FetchHistoryResults" })
}
