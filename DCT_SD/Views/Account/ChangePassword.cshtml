@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["HideAppChrome"] = true;
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 2rem;">
<div class="card p-4" style="max-width: 480px; width: 100%;">
    <h2 class="font-display fs-5 fw-semibold mb-1">Change Password</h2>
    <p class="text-muted small mb-3">You must change your password before you can continue.</p>

    <form asp-controller="Account" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert" style="white-space: pre-line;"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label field-label"></label>
            <input asp-for="Username" class="form-control" readonly tabindex="-1" />
        </div>

        <div class="mb-3">
            <label asp-for="OldPassword" class="form-label field-label"></label>
            <div class="position-relative">
                <input asp-for="OldPassword" type="password" class="form-control" style="padding-right: 4.5rem;"
                       autocomplete="current-password" placeholder="Enter current password" />
                <button type="button" class="btn btn-link btn-sm position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                        onclick="var i=document.getElementById('OldPassword'); i.type = i.type === 'password' ? 'text' : 'password'; this.textContent = i.type === 'password' ? 'SHOW' : 'HIDE';">SHOW</button>
            </div>
            <span asp-validation-for="OldPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <div class="field-label-row">
                <label asp-for="NewPassword" class="form-label field-label mb-0"></label>
                @await Html.PartialAsync("_FieldInfoTooltip", new FieldInfoTooltipViewModel { Title = "Password Requirements", Items = DCT_SD.Helpers.UserValidation.PasswordRequirements })
            </div>
            <div class="position-relative mt-2">
                <input asp-for="NewPassword" type="password" class="form-control" style="padding-right: 4.5rem;"
                       autocomplete="new-password" placeholder="Enter new password" />
                <button type="button" class="btn btn-link btn-sm position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                        onclick="var i=document.getElementById('NewPassword'); i.type = i.type === 'password' ? 'text' : 'password'; this.textContent = i.type === 'password' ? 'SHOW' : 'HIDE';">SHOW</button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small" style="white-space: pre-line;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label field-label"></label>
            <div class="position-relative">
                <input asp-for="ConfirmPassword" type="password" class="form-control" style="padding-right: 4.5rem;"
                       autocomplete="new-password" placeholder="Re-enter new password" />
                <button type="button" class="btn btn-link btn-sm position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                        onclick="var i=document.getElementById('ConfirmPassword'); i.type = i.type === 'password' ? 'text' : 'password'; this.textContent = i.type === 'password' ? 'SHOW' : 'HIDE';">SHOW</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-navy w-100 mt-2">Submit</button>
    </form>
</div>
</div>
