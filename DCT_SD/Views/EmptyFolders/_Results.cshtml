@model DCT_SD.Models.PagedResult<DCT_SD.Models.Dtos.EmptyFolders.EmptyFolderListItemDto>

<div class="table-responsive table-frame">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Fetch Date/Time</th>
                <th>RD Code</th>
                <th>RD Name</th>
                <th>Folder Name</th>
                <th>Folder Path</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No records found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="font-monospace small">@item.FetchDateTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@(item.RdCode ?? "—")</td>
                        <td>@(item.RdName ?? "—")</td>
                        <td>@item.FolderName</td>
                        <td class="font-monospace small">@item.FolderPath</td>
                        <td><status-badge status="@item.Status"></status-badge></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, ActionName = "Results" })
