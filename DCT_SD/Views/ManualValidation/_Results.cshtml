@using DCT_SD.Helpers
@model DCT_SD.Models.PagedResult<DCT_SD.Models.Dtos.ManualValidation.ManualValidationListItemDto>

<div class="table-responsive table-frame">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>RD Code</th>
                <th>RD Name</th>
                <th>Entry Number</th>
                <th>Extraction Status</th>
                <th>Extraction Date and Time</th>
                <th>Updated By</th>
                <th>Updated Date and Time</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No manual validation records found.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="font-monospace small">@(item.RdCode ?? "—")</td>
                        <td>@(item.RdName ?? "—")</td>
                        <td>@(item.EntryNumbersCsv ?? "—")</td>
                        @* Acceptance criteria requires the Extraction Status cell to read exactly
                           "Incomplete Extraction." (trailing period) - applied here, display-only.
                           The shared StatusDisplay map is intentionally left unchanged: it also
                           backs the Status column's EF value converter (see
                           ManualValidationRequestConfiguration), and existing rows already have
                           "Incomplete Extraction" (no period) stored - changing the shared map's
                           value would break parsing those rows back into the enum on read. *@
                        <td><status-badge status="@(item.Status == "IncompleteExtraction" ? "Incomplete Extraction." : StatusDisplay.ManualValidationStatusToDisplay(item.Status))"></status-badge></td>
                        <td class="font-monospace small">@item.ExtractionDate.ToIst().ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>
                            @if (item.UpdatedBy != null)
                            {
                                <span class="chip-mono">@item.UpdatedBy</span>
                            }
                            else
                            {
                                @:—
                            }
                        </td>
                        <td class="font-monospace small">@(item.UpdatedDate.ToIst()?.ToString("MM/dd/yyyy h:mm tt") ?? "—")</td>
                        <td>
                            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Details", "ManualValidation", new { id = item.Id })">View</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, ActionName = "Results" })
