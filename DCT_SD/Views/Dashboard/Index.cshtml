@model IReadOnlyList<DCT_SD.Models.Dtos.Dashboard.DashboardRowDto>
@using System.Globalization
@{
    // Every number below is a simple aggregate (sum/count) over the exact same rows the table
    // renders - nothing here calls a service or invents data. Null fields (columns that don't
    // apply to a given RecordType - see DashboardRowDto) are simply skipped by ?? 0 / Sum on
    // nullable ints, matching the table's own "N/A" treatment for those cells.
    string Cell(int? value) => value.HasValue ? value.Value.ToString("N0") : "N/A";

    var totalRds = Model.Select(r => r.RdCode).Distinct().Count();
    var totalFetched = Model.Sum(r => r.Fetched);
    var totalMigrated = Model.Sum(r => r.Migrated);
    var totalReadyForMigration = Model.Sum(r => r.ReadyForMigration ?? 0);
    var totalManualValidation = Model.Sum(r => r.ManualValidation ?? 0) + Model.Sum(r => r.IncompleteExtraction ?? 0);
    var totalEmptyFolders = Model.Sum(r => r.EmptyFolders ?? 0);

    string N(int value) => value.ToString("N0");

    // --- Record Status Mix donut - proportions among the same 4 aggregates the KPI cards above
    // already show (Migrated / Ready for Migration / Manual Validation / Empty Folders), nothing
    // else queried or invented. Rendered as plain inline SVG (stroke-dasharray per segment) so no
    // charting library is needed.
    var donutSegments = new (string Label, int Value, string Color)[]
    {
        ("Migrated", totalMigrated, "var(--color-ok-text)"),
        ("Ready for Migration", totalReadyForMigration, "var(--color-blue)"),
        ("Manual Validation", totalManualValidation, "var(--color-warn-text)"),
        ("Empty Folders", totalEmptyFolders, "var(--color-muted-2)"),
    };
    var donutTotal = donutSegments.Sum(s => s.Value);
    const double donutRadius = 54;
    const double donutCircumference = 2 * Math.PI * donutRadius;
    double donutCursor = 0;

    // --- Fetched vs Migrated per RD - same per-row Fetched/Migrated fields the table below
    // renders, summed across each RD's Folder+Images rows, top 6 RDs by Total.
    var rdBars = Model
        .GroupBy(r => new { r.RdCode, r.RdName })
        .Select(g => new
        {
            g.Key.RdCode,
            g.Key.RdName,
            Fetched = g.Sum(r => r.Fetched),
            Migrated = g.Sum(r => r.Migrated),
            Total = g.Sum(r => r.Total),
        })
        .OrderByDescending(x => x.Total)
        .Take(6)
        .ToList();
}

<div class="kpi-grid mb-4">
    <div class="kpi-card">
        <div class="kpi-card-icon is-info">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Registry Offices</div>
            <div class="kpi-card-value">@N(totalRds)</div>
            <div class="kpi-card-sub">Configured RDs</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12M12 16.5V3" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Total Fetched</div>
            <div class="kpi-card-value">@N(totalFetched)</div>
            <div class="kpi-card-sub">Folders + Images</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-icon is-ok">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Migrated</div>
            <div class="kpi-card-value">@N(totalMigrated)</div>
            <div class="kpi-card-sub">Folders + Images</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-icon is-info">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4M16 17H4m0 0l4 4m-4-4l4-4" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Ready for Migration</div>
            <div class="kpi-card-value">@N(totalReadyForMigration)</div>
            <div class="kpi-card-sub">Folders awaiting migration</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-icon is-warn">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75M3.75 4.5h16.5M3.75 4.5v15A2.25 2.25 0 006 21.75h12A2.25 2.25 0 0020.25 19.5v-15M3.75 4.5L6 2.25h12l2.25 2.25" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Manual Validation</div>
            <div class="kpi-card-value">@N(totalManualValidation)</div>
            <div class="kpi-card-sub">Pending review + incomplete</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-icon is-err">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 9.776c.112-.017.227-.026.344-.026h18.812c.117 0 .232.009.344.026m-19.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.06a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-19.5 0V6.108c0-1.135.845-2.098 1.976-2.192a48.424 48.424 0 011.876-.113m14.36 2.33V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.876-.113" /></svg>
        </div>
        <div>
            <div class="kpi-card-label">Empty Folders</div>
            <div class="kpi-card-value">@N(totalEmptyFolders)</div>
            <div class="kpi-card-sub">Across all RDs</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-xl-5">
        <div class="chart-card">
            <div class="section-heading">Record Status Mix</div>
            <div class="section-subtext mb-2">Share of tracked records across processing stages, from the same totals above.</div>
            @if (donutTotal == 0)
            {
                <div class="empty-state py-4">
                    <div class="empty-state-text">No records to chart yet.</div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center py-2">
                    <svg width="180" height="180" viewBox="0 0 140 140">
                        <circle cx="70" cy="70" r="@donutRadius" fill="none" stroke="var(--chart-track-stroke)" stroke-width="16" />
                        @foreach (var seg in donutSegments)
                        {
                            if (seg.Value <= 0) { continue; }
                            var fraction = (double)seg.Value / donutTotal;
                            var dash = fraction * donutCircumference;
                            var gap = donutCircumference - dash;
                            var offset = -donutCursor;
                            donutCursor += dash;
                            <circle cx="70" cy="70" r="@donutRadius" fill="none" stroke="@seg.Color" stroke-width="16"
                                    stroke-dasharray="@(dash.ToString("F2", CultureInfo.InvariantCulture)) @(gap.ToString("F2", CultureInfo.InvariantCulture))"
                                    stroke-dashoffset="@(offset.ToString("F2", CultureInfo.InvariantCulture))"
                                    transform="rotate(-90 70 70)" stroke-linecap="butt"
                                    style="transition: stroke-dasharray var(--transition-slow);"></circle>
                        }
                        <text x="70" y="66" text-anchor="middle" class="donut-center-value">@N(donutTotal)</text>
                        <text x="70" y="82" text-anchor="middle" class="donut-center-label">Tracked</text>
                    </svg>
                </div>
                <div class="chart-legend justify-content-center">
                    @foreach (var seg in donutSegments)
                    {
                        <div class="chart-legend-item">
                            <span class="chart-legend-swatch" style="background: @seg.Color;"></span>
                            @seg.Label (@N(seg.Value))
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="chart-card">
            <div class="section-heading">Migrated vs. Fetched by RD</div>
            <div class="section-subtext mb-2">Top Registry Offices by total record volume.</div>
            @if (rdBars.Count == 0)
            {
                <div class="empty-state py-4">
                    <div class="empty-state-text">No Registry of Deeds configured yet.</div>
                </div>
            }
            else
            {
                <div class="mt-2">
                    @foreach (var rd in rdBars)
                    {
                        var pct = rd.Fetched > 0 ? Math.Min(100, (int)Math.Round(rd.Migrated * 100.0 / rd.Fetched)) : 0;
                        <div class="rd-bar-row">
                            <div class="rd-bar-label" title="@rd.RdName">@rd.RdCode</div>
                            <div class="rd-bar-track">
                                <div class="rd-bar-fill" style="width: @(pct)%;"></div>
                            </div>
                            <div class="rd-bar-value">@N(rd.Migrated) / @N(rd.Fetched)</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card p-0">
    <div class="p-4 border-bottom">
        <div class="section-heading">Registry of Deeds Statistics</div>
        <div class="section-subtext">Per-RD Folder and Images record counts across every processing stage.</div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            <div class="empty-state-title">No Registry of Deeds configured</div>
            <div class="empty-state-text">Configure a Registry Office to start seeing Folder and Images statistics here.</div>
        </div>
    }
    else
    {
        <div class="table-responsive table-frame" style="border: 0; border-radius: 0;">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>RD Code</th>
                        <th>RD Name</th>
                        <th>Record Type</th>
                        <th>Fetched</th>
                        <th>WIP</th>
                        <th>Ready for Migration</th>
                        <th>Manual Validation</th>
                        <th>Incomplete Extraction</th>
                        <th>Migrated</th>
                        <th>Failed Migration</th>
                        <th>Empty Folders</th>
                        <th>Duplicate SD</th>
                        <th>Confirmed Duplicate</th>
                        <th>Inserted</th>
                        <th>N/A</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td><span class="chip-mono">@row.RdCode</span></td>
                            <td class="fw-medium">@row.RdName</td>
                            <td>
                                <span class="badge @(row.RecordType == "Folder" ? "badge-info" : "badge-neutral")">@row.RecordType</span>
                            </td>
                            <td>@row.Fetched</td>
                            <td>@row.Wip</td>
                            <td>@Cell(row.ReadyForMigration)</td>
                            <td>@Cell(row.ManualValidation)</td>
                            <td>@Cell(row.IncompleteExtraction)</td>
                            <td>@row.Migrated</td>
                            <td>@row.FailedMigration</td>
                            <td>@Cell(row.EmptyFolders)</td>
                            <td>@Cell(row.DuplicateSd)</td>
                            <td>@Cell(row.ConfirmedDuplicate)</td>
                            <td>@Cell(row.Inserted)</td>
                            <td>@Cell(row.NotApplicableOthers)</td>
                            <td class="fw-semibold">@row.Total</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
