    // variable or user secrets, same convention as every other credential in this file.
    "BaseUrl": "https://10.51.5.185:1551"
  },
  "TargetSystemValidation": {
    // The client's confirmed real SD Auto Conversion API response sample (2026-11-20) proves:
    // entryStatus == "Existing entry" -> "Existing"; Images[].status "Duplicate SD" -> "Existing";
    // Images[].status "Inserted" -> "Not Existing". Those three are hardcoded (MigrationService),
    // not configurable, because they're confirmed.
    //
    // The three settings below are NOT confirmed yet and are deliberately configurable so the
    // client's answer can be applied without a code change/redeploy once given:
    //
    // 1) What entryStatus looks like for a brand-new (not-yet-existing) entry has no confirmed
    //    sample - EntryNewValue is shown whenever entryStatus isn't the confirmed "Existing entry"
    //    value (absent, blank, or anything else).
    "EntryNewValue": "Not Existing",
    // 2) The confirmed "Existing title Entry No: ..." sample proves the TITLE itself already
    //    exists, but the client has NOT yet confirmed whether that means "Already Associated"
    //    (already linked to our target entry) or "Associated" (being linked to it for the first
    //    time via this call) - ExistingTitleValue is shown whenever titleStatus matches that
    //    confirmed "Existing title" pattern AND its embedded Entry No. matches what we submitted.
    "ExistingTitleValue": "Already Associated",
    // 3) What titleStatus looks like for a brand-new title has no confirmed sample either -
    //    TitleNewValue is shown whenever titleStatus is non-blank but doesn't match the confirmed
    //    "Existing title" pattern.
    "TitleNewValue": "Associated"
  },
  "RemoteFolderBrowser": {
    // UNC paths to always offer in the Browse picker, in addition to whatever mapped drives are
    // actually detected live. This exists for IIS: a drive letter mapped for the App Pool's
    // identity lives in a different logon session than IIS's own worker process, so Windows
    // never carries it across - a genuine OS-level limitation, not something this app's code can
    // work around. Leave empty on machines where live mapped-drive detection already works fine
    // (e.g. this dev machine, or an interactive VM session). Each entry must still be a network
    // location that identity actually has permission to read - this only removes the dependency
    // on a drive letter being visible, it does not grant any access on its own.
    "NetworkRoots": [],
    // true: skip live Windows drive-letter detection entirely and only ever offer the
    // NetworkRoots list above - for a deployment where only the explicitly configured path(s)
    // should ever be selectable, regardless of what happens to be mapped in the current session.
    "DisableLiveDetection": false
  }
}
