@model IReadOnlyList<DCT_SD.Models.Dtos.Dashboard.DashboardRowDto>
@{
    string Cell(int? value) => value.HasValue ? value.Value.ToString() : "N/A";
}

<div class="card p-4">
    <div class="table-responsive table-frame">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>RD Code</th>
                    <th>RD Name</th>
                    <th>Record Type</th>
                    <th>Fetched</th>
                    <th>WIP</th>
                    <th>Ready for Migration</th>
                    <th>Manual Validation</th>
                    <th>Incomplete Extraction</th>
                    <th>Migrated</th>
                    <th>Failed Migration</th>
                    <th>Empty Folders</th>
                    <th>Duplicate SD</th>
                    <th>Confirmed Duplicate</th>
                    <th>Inserted</th>
                    <th>N/A</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="16" class="text-center text-muted py-4">No Registry of Deeds configured.</td></tr>
                }
                else
                {
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@row.RdCode</td>
                            <td>@row.RdName</td>
                            <td>@row.RecordType</td>
                            <td>@row.Fetched</td>
                            <td>@row.Wip</td>
                            <td>@Cell(row.ReadyForMigration)</td>
                            <td>@Cell(row.ManualValidation)</td>
                            <td>@Cell(row.IncompleteExtraction)</td>
                            <td>@row.Migrated</td>
                            <td>@row.FailedMigration</td>
                            <td>@Cell(row.EmptyFolders)</td>
                            <td>@Cell(row.DuplicateSd)</td>
                            <td>@Cell(row.ConfirmedDuplicate)</td>
                            <td>@Cell(row.Inserted)</td>
                            <td>@Cell(row.NotApplicableOthers)</td>
                            <td class="fw-semibold">@row.Total</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
